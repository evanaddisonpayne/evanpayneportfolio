# Where the contact form posts its JSON (Formspree, Basin, a Vercel function, etc.).
# Leave empty and the form shows a "not wired up yet" note instead of sending.
NEXT_PUBLIC_CONTACT_ENDPOINT=
# Full URL of Evan's LinkedIn profile and the Brand Therapy newsletter.
# LinkedIn links stay hidden until these are set.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_NEWSLETTER_URL=
# /amsterdam trip chatbot ("Bram"). Server-side only — never NEXT_PUBLIC.
# ANTHROPIC_API_KEY is required for the chat to answer; TRIP_CHAT_CODE optionally
# makes the group enter a shared code once per device; TRIP_CHAT_MODEL overrides the model.
ANTHROPIC_API_KEY=
TRIP_CHAT_CODE=
TRIP_CHAT_MODEL=
